# Public Stellar address that receives the XLM payment. Never use a secret key here.
SELLER_PAY_TO=G_REPLACE_WITH_SELLER_PUBLIC_ADDRESS

# The hosted openx402 facilitator. No API key is required for this demo.
FACILITATOR_URL=https://facilitator-production-8430.up.railway.app

# Optional on Railway: the API derives this from RAILWAY_PUBLIC_DOMAIN.
# Set it for custom domains or local tunnel testing. Do not include /joke.
SELLER_PUBLIC_URL=https://your-joke-api.up.railway.app

PORT=4788

