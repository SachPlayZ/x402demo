# Keep this file local. Never commit or deploy the recovery phrase.
# BIP-39 recovery phrase (12 or 24 words) for the testnet buyer wallet.
BUYER_RECOVERY_PHRASE="word word word word word word word word word word word word"

# Optional. SEP-0005 account index on m/44'/148'/<index>'. Defaults to 0.
BUYER_ACCOUNT_INDEX=0

# Optional. BIP-39 passphrase ("25th word"). Leave unset unless your wallet uses one.
BUYER_RECOVERY_PASSPHRASE=

# Fill this after deploying the API.
JOKE_API_URL=

FACILITATOR_URL=https://facilitator-production-8430.up.railway.app
